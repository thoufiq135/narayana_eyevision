# --- MediaMTX (RTSP -> WebRTC/WHEP bridge) ---
# If mediamtx.exe is running on THIS same machine (the common case for
# local dev), this must be localhost, not a LAN IP that nothing is
# listening on. Change to the server's real LAN IP only if MediaMTX runs
# on a separate machine and you've confirmed that IP responds.
VITE_MEDIAMTX_URL=http://localhost:8889

# --- Detection AI backend (WebSocket pushing bounding boxes) ---
# Same rule: point this at wherever your detection service is actually
# running. If you don't have one running yet, this will keep timing out
# regardless of what's fixed on the video side — that's a separate
# service you still need to start.
VITE_DETECTION_WS_URL=ws://localhost:8080/detections

# --- Camera path name for the real RTSP camera ---
# Must exactly match a `paths:` entry name in mediamtx.yml.
# mediamtx.yml currently defines the path as `entry_gate` — if you rename
# it there, update this to match (and vice versa). They must be identical.
VITE_CAMERA_GATE_ID=entry_gate

# --- API base (student data / meals / reports REST API, if used) ---
VITE_API_BASE_URL=http://localhost:4000/api

# --- Feature flags for local dev without real hardware ---
VITE_USE_MOCK_CAMERA=false
VITE_USE_MOCK_DETECTIONS=false

VITE_RECOGNITION_API_URL=http://100.88.60.87:8000

# NOTE: the RTSP camera URL (with credentials) is intentionally NOT here.
# Anything prefixed VITE_ is bundled into client-side JS and visible to
# anyone who opens devtools. The RTSP URL lives only in mediamtx.yml,
# which runs server-side.